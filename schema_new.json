          "fields":[
            {
              "name": "eventUUID",
              "type": "string",
              "doc": "A unique identifier for this particular event. The event producer allocates the eventId. Has to be in UUID v4 format (i.e. 535c5d5d-fc48-4205-b85c-1a956e9d1234)"
            },
            {
              "name": "subject",
              "type": {
                "type": "record",
                "name": "EventWebSubject",
                "doc": "A party can have multiple records in OCV. This and ocvID would uniquely identify a Party Record within OCV",
                "fields": [
                  {
                    "name": "subjectType",
                    "type": "string",
                    "doc": "The type of identifier, such as CRN, or OCV Id, or CARCIS1d"
                  },
                  {
                    "name": "subjectId",
                    "type": "string",
                    "doc": "The actual value of the identifier - that would be the actual CRN, for example"
                  }
                ]
              }
            },
            {
              "name": "occurrenceDateTime",
              "type": "long",
              "doc": "The date and time, to millisecond precision, that this event occurred"
            },
            {
              "name": "traceId",
              "type": "string"
            },
            {
              "name": "spanId",
              "type": "string"
            },
            {
              "name": "source",
              "type": "string",
              "doc": "The service identifier that produced the event"
            },
            {
              "name": "hierarchy",
              "type": "string",
              "doc": "Business Event Type Hierarchy, i.e. AU/RETAIL/CARDS"
            }
          ]
        }
      ]
    },
