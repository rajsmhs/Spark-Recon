{{ config(
    materialized='table',
    table_type='iceberg'
) }}

{% set table_count = 0 %}
{% set target_table = source('your_source_name', 'your_table_name') %}

{% if execute %}
    {% set count_query %}
        SELECT COUNT(*) as table_count
        FROM {{ target_table }}
    {% endset %}
    
    {% set results = run_query(count_query) %}
    {% if results %}
        {% set table_count = results.columns[0].values()[0] %}
    {% endif %}
{% endif %}

{% if table_count == 0 %}
    {# Empty table - return default message #}
    select 
        'NO_DATA' as status,
        0 as record_count,
        CURRENT_TIMESTAMP as check_time
        
{% elif table_count <= 5000 %}
    {# Small table - detailed analysis #}
    select
        transaction_id,
        customer_id,
        transaction_date,
        unit_price,
        quantity,
        (unit_price * quantity) as total_amount,
        'DETAILED_VIEW' as analysis_type
    from {{ target_table }}
    order by transaction_date desc
    
{% else %}
    {# Large table - aggregated view #}
    select
        DATE_TRUNC('month', CAST(transaction_date AS DATE)) as month,
        COUNT(*) as transaction_count,
        SUM(unit_price * quantity) as total_revenue,
        AVG(unit_price) as avg_unit_price,
        'SUMMARY_VIEW' as analysis_type
    from {{ target_table }}
    group by DATE_TRUNC('month', CAST(transaction_date AS DATE))
    order by month desc
    
{% endif %}
